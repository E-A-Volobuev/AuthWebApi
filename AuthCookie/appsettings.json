{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Параметры должны совпадать с Jwt-секцией AuthService, иначе токен не пройдёт валидацию
  "Jwt": {
    "Secret": "SuperSecretKeyForJwtTokenSigning-ChangeMeInProduction-1234567890",
    "Issuer": "AuthService",
    "Audience": "ResourceService",
    "ExpireInMinutes": "60"
  }
}
